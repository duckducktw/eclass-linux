{
  "name": "eclass-linux",
  "version": "0.1.1",
  "description": "Linux (Electron) reimplementation of the eClass 補習班課程播放器 client",
  "main": "src/main/main.js",
  "author": "duckducktw <dianasogooda@gmail.com>",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "smoke": "node test/smoke.js",
    "api-test": "node test/api-cli.js",
    "dist": "electron-builder",
    "dist:all": "electron-builder -mwl",
    "core:copy": "node scripts/copy-core-to-www.js",
    "cap:sync": "npm run core:copy && cap sync android",
    "cap:apk": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/cli": "^6.2.3",
    "@capacitor/core": "^6.2.3",
    "@capacitor/device": "^6.0.3",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "tw.duckduck.eclasslinux",
    "productName": "eClass Linux",
    "afterPack": "build/after-pack.js",
    "files": [
      "src/**/*",
      "!**/*.md"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "AudioVideo",
      "executableArgs": [
        "--no-sandbox"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education"
    }
  }
}
